# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Needed for --orgo and --orgo-agent. Get one at https://www.orgo.ai/settings/credentials
ORGO_API_KEY=
# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# ORGO_WORKSPACE_ID=
# ORGO_AGENT_MODEL=claude-opus-5.5   # or orgo-agent-opus-5.5 (Orgo's own engine on Opus 5.5)
# Free Orgo accounts (no plan) run computers on credits: set this to hourly
# ORGO_BILLING_MODE=hourly
